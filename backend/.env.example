# Moss backend settings. Copy to backend/.env and fill in what you have.
# Everything is optional: with an empty file Moss runs fully offline on seeded data (mock mode).
# Never commit .env, credentials.json or token.json.

# ---------------------------------------------------------------- LLM
# Gemini API key from https://aistudio.google.com/apikey (empty = offline, rule-based answers)
GEMINI_API_KEY=
# Model for chat and action proposals
GEMINI_MODEL=gemini-3.8-flash
# Cheaper model for extraction
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Optional OpenAI-compatible fallback, e.g. freellmapi: http://localhost:3001/v1 (empty = no fallback)
FALLBACK_BASE_URL=
# API key for the fallback endpoint ("none" if it does not check one)
FALLBACK_API_KEY=none
# Model name exactly as the fallback's /v1/models lists it (empty = no fallback)
FALLBACK_MODEL=

# ---------------------------------------------------------------- Memory
# SQLite file. Leave commented out for backend/data/moss.db (an empty value would break the path)
# MOSS_DB=C:\path\to\moss.db
# Knowledge graph: auto (Graphiti when Neo4j + Gemini are set) | graphiti | local (SQLite only, no extra LLM calls)
GRAPH_BACKEND=auto
# Neo4j bolt address (Neo4j Desktop default)
NEO4J_URI=bolt://localhost:7687
# Neo4j user
NEO4J_USER=neo4j
# Neo4j password (empty = Graphiti off)
NEO4J_PASSWORD=

# ---------------------------------------------------------------- Connectors
# 1 = ignore all credentials below and use the seeded mock connectors
MOSS_FORCE_MOCK=0

# Atlassian site URL, e.g. https://yoursite.atlassian.net (Jira and Confluence go live when all three are set)
ATLASSIAN_SITE=
# Atlassian account email
ATLASSIAN_EMAIL=
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=
# Jira project key
JIRA_PROJECT=PLAT
# Confluence space key
CONFLUENCE_SPACE=ENG

# Slack bot token, xoxb-… (Slack goes live when set)
SLACK_BOT_TOKEN=
# Channel used when an action names none (no #)
SLACK_DEFAULT_CHANNEL=platform

# Google OAuth client file, "Desktop app" type. Leave commented out for backend/credentials.json
# GOOGLE_CREDENTIALS=C:\path\to\credentials.json
# Token written by `python -m moss.connectors.google_auth`; Gmail + Calendar go live when it exists. Leave commented out for backend/token.json
# GOOGLE_TOKEN=C:\path\to\token.json
# Email real invited guests when Moss creates an event: all | externalOnly | none
CALENDAR_SEND_UPDATES=all

# ---------------------------------------------------------------- Voice
# ElevenLabs API key (empty = the browser's built-in speech)
ELEVENLABS_API_KEY=
# Voice id (empty = ElevenLabs' documented example voice "George", JBFqnCBsd6RMkjVDRZzb)
ELEVENLABS_VOICE_ID=
# Text-to-speech model
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---------------------------------------------------------------- Web
# Comma-separated origins allowed to call the API (the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
